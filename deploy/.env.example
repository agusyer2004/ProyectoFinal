# Copiar a deploy/.env (make up lo hace solo si falta). No commitear .env.

# --- Kafka ---
KAFKA_IMAGE=apache/kafka:4.0.0
# Puerto del listener EXTERNAL, solo para depurar desde el host.
KAFKA_EXTERNAL_PORT=9094

# --- Tópicos (deploy/kafka/create-topics.sh) ---
# events NO se cambia una vez creado: agregar particiones rompe el orden por actor_id (ADR-005).
EVENTS_PARTITIONS=12
ALERTS_PARTITIONS=12
ACTOR_RISK_PARTITIONS=12
DLQ_PARTITIONS=3
POLICIES_PARTITIONS=1
EVENTS_RETENTION_DAYS=7
ALERTS_RETENTION_DAYS=14
DLQ_RETENTION_DAYS=30
# Los tópicos compactados solo compactan segmentos cerrados: chico en desarrollo.
COMPACT_SEGMENT_MS=60000
